{
  "$schema": "https://schema.tauri.app/config/2.0.0",
  "productName": "Unicity Agentic Demo",
  "version": "0.1.0",
  "identifier": "com.unicity.demo",
  "build": {
    "frontendDist": "../src-ui/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm --prefix ../src-ui run dev",
    "beforeBuildCommand": "npm --prefix ../src-ui run build"
  },
  "app": {
    "windows": [
      {
        "title": "Unicity Agentic Demo",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "titleBarStyle": "Overlay"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "entitlements": null,
      "exceptionDomain": "",
      "frameworks": [],
      "providerShortName": null,
      "signingIdentity": null,
      "infoPlist": "./Info.plist"
    }
  },
  "plugins": {}
}