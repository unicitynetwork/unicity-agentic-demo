# LLM Configuration Examples
# Copy this file to .env and modify with your actual values

# Required: Your LLM API key
API_KEY=your-api-key-here

# Optional: Custom LLM configuration
# Uncomment and modify these lines to use a different LLM provider

# OpenAI GPT-4
# LLM_BASE_URL=https://api.openai.com/v1/chat/completions
# LLM_MODEL=gpt-4

# OpenAI GPT-3.5 Turbo
# LLM_BASE_URL=https://api.openai.com/v1/chat/completions
# LLM_MODEL=gpt-3.5-turbo

# Anthropic Claude (alternative to API_KEY)
# ANTHROPIC_API_KEY=your-anthropic-key

# Custom OpenAI-compatible API
# LLM_BASE_URL=https://your-api-endpoint.com/v1/chat/completions
# LLM_MODEL=your-custom-model

# Default (z.ai GLM-4.6) - no additional configuration needed
# Just set API_KEY to your z.ai API key